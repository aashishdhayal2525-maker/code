// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// Strategy version of swastika_signal_clone.pine for TradingView's Strategy
// Tester. Same rules as swastika/engine.py: orders fill at the next bar's
// open, 1 contract, 0.01% commission per side, 5 ticks slippage per side.
// The Python engine checks the profit lock minute by minute; turn on
// "Bar Magnifier" in the strategy properties to get closest to that.
//@version=5
strategy("Swastika Signal (reconstructed) - strategy", shorttitle="SS-clone strat", overlay=true,
         default_qty_type=strategy.fixed, default_qty_value=1,
         commission_type=strategy.commission.percent, commission_value=0.01, slippage=5)

mode      = input.string("Day filter", "Trade mode", options=["Day filter", "Reversal", "EMA filter", "Magical"],
     tooltip="Day filter = take Buy/Sell only when the Day row agrees; exit on the opposite label. Best in the Jan 2025 - Sep 2026 backtest.")
stLen     = input.int(20,    "Band ATR length")
fastMult  = input.float(5.0, "Inner line multiplier", step=0.1)
slowMult  = input.float(6.0, "Outer line multiplier", step=0.1)
cyanLen   = input.int(14,    "Cyan ATR length")
cyanMult  = input.float(5.0, "Cyan ATR multiplier", step=0.1)
emaLen    = input.int(200,   "Trend EMA length")
htfLen    = input.int(20,    "Day/1h/4h filter band ATR length", group="Higher-timeframe filters")
htfMult   = input.float(6.0, "Day/1h/4h filter band multiplier", step=0.1, group="Higher-timeframe filters",
     tooltip="The Day, 1h and 4h filters always use the real Swastika band (ATR 20, x6), even if the chart band above is changed.")
useLock   = input.bool(true,  "Lock profit once the trade is ahead", group="Win-rate options",
     tooltip="Once price moves +0.5R in your favour (R = entry to outer band), move the stop to +0.1R. Backtest: win rate ~60% -> ~80%, profit -12% to -22% (more in Gold 2026).")
lockTrig  = input.float(0.5, "Lock trigger (R)", step=0.1,  group="Win-rate options")
lockAt    = input.float(0.1, "Locked stop (R)",  step=0.05, group="Win-rate options")
reN       = input.int(0, "Re-enter the trend on an N-bar breakout (0 = off)", minval=0, group="More trades",
     tooltip="While flat and the band and Day row still agree, re-enter when a bar closes beyond the previous N bars' high (long) / low (short). Backtest with N = 20 on the 30m chart: Silver 3.5 trades/month, 71% wins; Gold weaker in 2026.")
useH4     = input.bool(false, "Only trade with the 4h band", group="Win-rate options")
exitH1    = input.bool(false, "Also exit when the 1h band flips against the trade", group="Win-rate options")
useH1     = input.bool(false, "Only trade with the 1h band (for 5m/15m charts)", group="Win-rate options",
     tooltip="Take signals only when the real 1h Swastika band agrees. Silver 5m with this, lock 0.15R at 0.3R and re-entry N = 120: ~16 trades/month, ~76% wins in the backtest.")
confirm1  = input.bool(false, "Wait 1 bar for follow-through", group="Win-rate options",
     tooltip="Enter one bar later, only if the band held and that bar closed beyond the signal bar. Backtest: win rate ~90%, half the trades, ~40% less profit. Chosen after seeing results; small sample.")

[stFast, dFastTV] = ta.supertrend(fastMult, stLen)
[stSlow, dSlowTV] = ta.supertrend(slowMult, stLen)
bandDir = -dSlowTV
buySig  = bandDir == 1  and bandDir[1] == -1
sellSig = bandDir == -1 and bandDir[1] == 1

nLoss = cyanMult * ta.atr(cyanLen)
var float trail = na
p = nz(trail[1])
trail := close > p and close[1] > p ? math.max(p, close - nLoss) :
         close < p and close[1] < p ? math.min(p, close + nLoss) :
         close > p ? close - nLoss : close + nLoss
cyanDir  = close > trail ? 1 : -1
trendEma = ta.ema(close, emaLen)
emaDir   = close > trendEma ? 1 : -1

bull = bandDir == 1  and cyanDir == 1  and emaDir == 1
bear = bandDir == -1 and cyanDir == -1 and emaDir == -1
var bool legFired = false
if bandDir != bandDir[1]
    legFired := false
magicBuy  = bull and not legFired
magicSell = bear and not legFired
if magicBuy or magicSell
    legFired := true

htfDirExpr() =>
    [_, d] = ta.supertrend(htfMult, htfLen)
    -d
dayDir = request.security(syminfo.tickerid, "D", htfDirExpr()[1], lookahead=barmerge.lookahead_on)

h1Dir = request.security(syminfo.tickerid, "60", htfDirExpr()[1], lookahead=barmerge.lookahead_on)
h4Dir = request.security(syminfo.tickerid, "240", htfDirExpr()[1], lookahead=barmerge.lookahead_on)
h1Ok(side) => (not useH1 or h1Dir == side) and (not useH4 or h4Dir == side)

goLong  = h1Ok(1)  and (confirm1 ? (buySig[1]  and bandDir == 1  and close > close[1] and dayDir[1] == 1)  : (buySig  and dayDir == 1))
goShort = h1Ok(-1) and (confirm1 ? (sellSig[1] and bandDir == -1 and close < close[1] and dayDir[1] == -1) : (sellSig and dayDir == -1))

hiN = ta.highest(high, math.max(reN, 1))[1]
loN = ta.lowest(low, math.max(reN, 1))[1]
reLong  = reN > 0 and strategy.position_size == 0 and not goLong and not goShort and bandDir == 1  and dayDir == 1  and h1Ok(1)  and close > hiN
reShort = reN > 0 and strategy.position_size == 0 and not goLong and not goShort and bandDir == -1 and dayDir == -1 and h1Ok(-1) and close < loN

if mode == "Day filter"
    if reLong
        strategy.entry("L", strategy.long, comment="re-entry")
    if reShort
        strategy.entry("S", strategy.short, comment="re-entry")
    if buySig
        strategy.close("S")
    if sellSig
        strategy.close("L")
    if goLong and strategy.position_size <= 0
        strategy.entry("L", strategy.long)
    if goShort and strategy.position_size >= 0
        strategy.entry("S", strategy.short)
else if mode == "Reversal"
    if buySig
        strategy.entry("L", strategy.long)
    if sellSig
        strategy.entry("S", strategy.short)
else if mode == "EMA filter"
    if buySig
        strategy.close("S")
        if emaDir == 1
            strategy.entry("L", strategy.long)
    if sellSig
        strategy.close("L")
        if emaDir == -1
            strategy.entry("S", strategy.short)
else
    if magicBuy
        strategy.entry("L", strategy.long)
    else if magicSell
        strategy.entry("S", strategy.short)
    else if sellSig
        strategy.close("L")
    else if buySig
        strategy.close("S")

if exitH1 and strategy.position_size > 0 and h1Dir == -1
    strategy.close("L", comment="1h flip")
if exitH1 and strategy.position_size < 0 and h1Dir == 1
    strategy.close("S", comment="1h flip")

// ── Profit lock (R = entry to the outer band at the signal bar) ─────────
var float entryPx = na
var float riskPts = na
var bool  locked  = false
newPos = strategy.position_size != 0 and math.sign(strategy.position_size) != math.sign(nz(strategy.position_size[1]))
if newPos
    entryPx := strategy.position_avg_price
    riskPts := math.abs(entryPx - stSlow[1])   // band on the bar the order was placed
    locked  := false
if strategy.position_size > 0 and not locked and high - entryPx >= lockTrig * riskPts
    locked := true
if strategy.position_size < 0 and not locked and entryPx - low >= lockTrig * riskPts
    locked := true
if useLock and locked and strategy.position_size > 0
    strategy.exit("lockL", from_entry="L", stop=entryPx + lockAt * riskPts)
if useLock and locked and strategy.position_size < 0
    strategy.exit("lockS", from_entry="S", stop=entryPx - lockAt * riskPts)
plot(useLock and locked and strategy.position_size != 0 ? entryPx + math.sign(strategy.position_size) * lockAt * riskPts : na,
     "Locked stop", color=color.yellow, style=plot.style_linebr, linewidth=2)

pFast = plot(stFast, "Inner line", color=#2962ff, style=plot.style_stepline)
pSlow = plot(stSlow, "Outer line", color=#ff1744, style=plot.style_stepline)
fill(pFast, pSlow, color=bandDir == 1 ? color.new(#2e7d32, 55) : color.new(#c62828, 55))
plot(ta.ema(trail, 5), "Cyan trail", color=#00bcd4, linewidth=2)
plot(trendEma, "Trend EMA", color=#e040fb, linewidth=2)
